{
  "name": "wardwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:web": "esbuild src/web/main.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/app.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "dev": "npm run build:web && python dev/cf.py dev",
    "deploy": "npm run build:web && python dev/cf.py deploy"
  },
  "dependencies": {
    "ag-charts-community": "^12.3.1",
    "ag-grid-community": "^34.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
