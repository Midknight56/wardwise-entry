{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wardwise",
  // The hackathon account. Deploy with `npm run deploy` (python dev/cf.py deploy). For your own account copy this
  // file, add your "account_id", and drop the shared LEDGER (the AI cap then needs your own D1 database).
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 18823, "ip": "127.0.0.1" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/webhooks/*", "/healthz", "/return/*"] },
  "ai": { "binding": "AI" },
  // The shared neuron ledger of every hackathon app on the account. Remote even in `wrangler dev`, so local runs count.
  "d1_databases": [{ "binding": "LEDGER", "database_name": "hackathon-ledger", "database_id": "023377a8-ad19-413c-b769-d195d05427b3", "remote": true }],
  "durable_objects": {
    "bindings": [
      { "name": "CAMPAIGN", "class_name": "CampaignDO" },
      { "name": "GATE", "class_name": "GateDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CampaignDO", "GateDO"] }],
  "vars": { "BUILD_TAG": "2026-11-06", "PAYPAL_BASE": "https://api-m.sandbox.paypal.com", "LIVE_AI": "1", "DEV_ROUTES": "0" },
  "observability": { "enabled": true }
}
